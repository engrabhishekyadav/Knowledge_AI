# ==========================================================
# KnowledgeAI Docker Compose Environment Configuration
# Copy this file to '.env' on your AWS EC2 instance:
#   cp .env.example .env
# ==========================================================

# AI Providers (At least one required)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JWT Authentication Secret Key
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production

# CORS Origins - Allow your AWS IP and Ports (or * for all)
CORS_ORIGINS=["*"]

# ==========================================================
# KnowledgeAI Backend Environment Configuration Template
# Copy this file to '.env' and fill in your credentials.
# ==========================================================

# AI Model Provider: 'gemini' (Recommended) or 'openrouter'
LLM_PROVIDER=gemini

# Google Gemini AI Configuration (Primary)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenRouter AI Configuration (Alternative / Fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database Configuration: PostgreSQL 16 (with pgvector extension required)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/knowledge_ai

# Vector Search Settings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VECTOR_DIMENSION=768
HYBRID_DEFAULT_WEIGHT=0.65

# Application Settings
APP_NAME=KnowledgeAI Backend
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Security & JWT Token (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
